{
  "name": "lumen-native",
  "version": "0.1.1",
  "private": true,
  "description": "Native Rust desktop widgets",
  "scripts": {
    "start": "python run_lumen.py",
    "build": "python run_native_dock.py --build-only",
    "check:safe": "node scripts/check-safe.mjs",
    "test:safe": "node --test --test-isolation=none scripts/test-check-safe.mjs",
    "test:music": "node --test --test-isolation=none scripts/test-native-music.mjs",
    "test:controls": "python -I scripts/test-system-controls.py",
    "build:music": "node scripts/build-native-music.mjs"
  },
  "dependencies": {
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
